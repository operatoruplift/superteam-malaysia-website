# Superteam Malaysia website configuration. Every variable is optional: with none set,
# the site renders the static content in src/data/site.ts.

# Supabase project URL and anon key. With both set, events, members, partners, projects
# and testimonials are read from Supabase, falling back to the static data when a table
# is missing or empty. /admin also uses the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key, read only by createAdminClient() in src/lib/supabase.ts (not called
# by any page yet). Server-side only: never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for metadata and social images. Defaults to https://sun-valley-rouge.vercel.app
NEXT_PUBLIC_SITE_URL=

# The /admin sign-in password, checked on the server by /api/admin/login. Without it
# /admin stays locked. Server-side only: never expose it with a NEXT_PUBLIC_ prefix.
ADMIN_PASSWORD=
